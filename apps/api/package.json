{
  "name": "@nyz-rag/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "test": "node --import tsx/esm --test test/contracts.test.ts test/queue.test.ts test/app.test.ts test/admin-auth.test.ts test/admin-accounts.test.ts test/user-auth.test.ts test/rate-limit.test.ts test/knowledge-events.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@nyz-rag/processing": "workspace:*",
    "@nyz-rag/types": "workspace:*",
    "bullmq": "^5.58.5",
    "fastify": "^5.6.1",
    "ioredis": "^5.8.1",
    "nodemailer": "^10.1.7"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
