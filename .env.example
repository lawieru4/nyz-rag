NODE_ENV=development
API_PORT=3001
WEB_PORT=5175
ADMIN_PORT=5176
# Persistent administrator accounts stored in PostgreSQL.
# ADMIN_PASSWORD seeds the initial super admin on first startup (16-1024 chars).
# After the seed, change credentials on the admin profile page, not via env vars.
# Empty ADMIN_PASSWORD skips the seed (accounts already in DB are not affected).
ADMIN_EMAIL=admin@example.com
# Initial nickname and legacy login alias; newly created administrators log in by email.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Exact browser origins, comma separated. Set the actual HTTPS origin for deployment.
ADMIN_ORIGINS=http://localhost:5176,http://127.0.0.1:5176
# false is ONLY for local HTTP (including local Docker). Set true behind HTTPS.
# If unset: true in production, false otherwise. Use the same host for API and admin.
ADMIN_COOKIE_SECURE=false
# Sessions expire after 8 hours; logout revokes them in Redis.
# Disable/password-change revokes all sessions via session version.
# Login limit: 10 attempts per resolved client IP / 15 min.
# User accounts (web app): browser origins allowed to call user APIs with cookies (visitor/login).
# Same-origin deployments (Docker/Nginx) need no entry. Exact origins, comma separated.
WEB_ORIGINS=http://localhost:5175,http://127.0.0.1:5175
# Same rule as ADMIN_COOKIE_SECURE: false ONLY for local HTTP (including local Docker).
USER_COOKIE_SECURE=false
# Email codes for registration and password reset. Without SMTP_HOST, non-production API logs
# the email instead of sending it; production returns 503 for those endpoints. API only.
SMTP_HOST=
# 587 uses STARTTLS when available; 465 is implicit TLS (SMTP_SECURE defaults to true for 465).
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# Required with SMTP_HOST, e.g. "NYZ 知识问答 <no-reply@example.com>".
MAIL_FROM=
# Shared PostgreSQL 18 + pgvector; provision a dedicated database and role first.
# Replace the password with the actual nyzrag role password (URL-encoded if needed).
DATABASE_URL=postgresql://nyzrag:nyzrag@localhost:5432/nyzrag
REDIS_URL=redis://localhost:6379
# Explicit trusted reverse-proxy IPs/CIDRs, comma separated; empty = direct connections only.
# Set this to your actual Nginx proxy addresses before opening the service publicly.
# Never trust 0.0.0.0/0 or ::/0. Untrusted X-Forwarded-For headers are ignored.
TRUSTED_PROXIES=
# Redis admission is always enabled and fails closed (503) if Redis is unavailable.
# API and worker must share DOCUMENT_QUEUE_NAME, REDIS_URL and model limit settings.
# Fixed-window requests; 429 includes Retry-After (seconds). Health/preflight are exempt.
# Once SSE headers are sent, model admission failures use the existing error event instead.
RATE_LIMIT_WINDOW_MS=60000
API_IP_RATE_LIMIT_MAX=120
# Verified accounts on cookie-aware chat/messages/auth routes; stateless APIs use IP limits.
API_USER_RATE_LIMIT_MAX=60
# Both single-answer and SSE chat share these request/concurrent-work budgets.
# Anonymous cookies are additionally limited, but IP caps remain even if cookies rotate.
CHAT_IP_RATE_LIMIT_MAX=20
CHAT_USER_RATE_LIMIT_MAX=10
CHAT_IP_CONCURRENCY_LIMIT=4
CHAT_USER_CONCURRENCY_LIMIT=2
CHAT_GLOBAL_CONCURRENCY_LIMIT=32
# Per provider/model/kind, shared by API and worker. Each embedding batch counts once.
MODEL_RATE_LIMIT_MAX=120
MODEL_CONCURRENCY_LIMIT=8
# Docker startup maps loopback hosts above to host.docker.internal automatically.
# All metadata and vectors live in this database; API and Worker apply migrations on startup.
DOCUMENT_QUEUE_NAME=nyz-rag-document-processing
VITE_API_URL=http://localhost:3001
# Set this in both API and Worker; reference its name in the default model provider.
OPENAI_API_KEY=
# Data sources: token for the nyzdata article API (Worker only; never put it in the source URL).
NYZ_ARTICLE_TOKEN=
# Max articles fetched per sync run (the rest continues next run) and quiet list pages before the head scan stops.
NYZ_ARTICLE_SYNC_LIMIT=200
NYZ_ARTICLE_OVERLAP_PAGES=2
# Delay between article API requests and per-request timeout (milliseconds; minimum 1000).
NYZ_ARTICLE_REQUEST_DELAY_MS=1000
NYZ_ARTICLE_REQUEST_TIMEOUT_MS=15000
