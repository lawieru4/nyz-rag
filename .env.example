NODE_ENV=development
API_PORT=3001
WEB_PORT=5175
ADMIN_PORT=5176
# Single administrator; no default password. Empty password disables admin access (503).
# Use a unique random password of 16-1024 characters. API only; never VITE_*.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Exact browser origins, comma separated. Set the actual HTTPS origin for deployment.
ADMIN_ORIGINS=http://localhost:5176,http://127.0.0.1:5176
# false is ONLY for local HTTP (including local Docker). Set true behind HTTPS.
# If unset: true in production, false otherwise. Use the same host for API and admin.
ADMIN_COOKIE_SECURE=false
# Sessions expire after 8 hours; logout revokes them in Redis. Credential changes revoke all sessions.
# Login limit: 10 attempts per connection IP / 15 min; reverse-proxy clients share that budget.
# Shared PostgreSQL 18 + pgvector; provision a dedicated database and role first.
# Replace the password with the actual nyzrag role password (URL-encoded if needed).
DATABASE_URL=postgresql://nyzrag:nyzrag@localhost:5432/nyzrag
REDIS_URL=redis://localhost:6379
# Docker startup maps loopback hosts above to host.docker.internal automatically.
# All metadata and vectors live in this database; API and Worker apply migrations on startup.
DOCUMENT_QUEUE_NAME=nyz-rag-document-processing
VITE_API_URL=http://localhost:3001
# Set this in both API and Worker; reference its name in the default model provider.
OPENAI_API_KEY=
# Article API sources: token for the nyzdata article API (Worker only; never put it in the source URL).
NYZ_ARTICLE_TOKEN=
# Max articles fetched per sync run (the rest continues next run) and quiet list pages before the head scan stops.
NYZ_ARTICLE_SYNC_LIMIT=200
NYZ_ARTICLE_OVERLAP_PAGES=2
