# 生产环境变量：复制到服务器 /opt/nyz-rag/.env（与 compose.yml 同目录），按注释填写。不要提交填好的文件。
# TRUSTED_PROXIES 由 compose.yml 用两个网段拼出，这里不要写。

# 镜像版本：与 scripts/package-images.ps1 的 -Version 一致；发布新版本只改这一处。
NYZ_VERSION=
# Compose 网络网段，同时作为 API 的可信代理（TRUSTED_PROXIES）。
# 不能与服务器内网（ip route 查看）和已有 Docker 网络（docker network inspect）重叠。
NYZ_SUBNET=10.250.250.0/24
# 1Panel 应用所在网络及其网段（docker network inspect 1panel-network -f '{{range .IPAM.Config}}{{.Subnet}}{{end}}'），
# api 与 worker 经它访问共用的 PostgreSQL、Redis；网段同样作为可信代理。
NYZ_SHARED_NETWORK=1panel-network
NYZ_SHARED_SUBNET=
# 宿主机端口（只绑定 127.0.0.1，由 OpenResty 反向代理）；booth-ai 已占用 3000、19000、19001。
NYZ_API_PORT=3010
NYZ_WEB_PORT=5010
NYZ_ADMIN_PORT=5011

# 共用的 1Panel PostgreSQL、Redis，主机名为容器名（docker ps 查看）。密码含字母数字以外的字符时须 URL 编码。
# PostgreSQL：专用库与非超级用户账号 nyzrag（建法见部署手册第 4 节），密码用 openssl rand -hex 24 生成。
DATABASE_URL=postgresql://nyzrag:<密码>@1Panel-postgresql-XXXX:5432/nyzrag
# Redis：1Panel 中设置的密码；末尾的编号是本项目独占的逻辑库，不与其他项目共用编号。
REDIS_URL=redis://:<密码>@1Panel-redis-XXXX:6379/1
# 后台密钥（模型 API Key、nyzdata token）的主密钥，≥32 字符；更换后已保存的密钥无法解密。
# 迁移本地数据时必须与本地 .env 相同。生成：openssl rand -base64 32
NYZ_SECRET_KEY=

DOCUMENT_QUEUE_NAME=nyz-rag-document-processing

# 首个超级管理员（只在数据库中还没有管理员时创建）；登录后在个人资料页修改密码，再清空 ADMIN_PASSWORD。
ADMIN_EMAIL=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# 管理端与用户端的 HTTPS 来源（与浏览器地址栏完全一致，不带末尾 /）。
ADMIN_ORIGINS=https://ragadmin.baolinfeng.cn
ADMIN_COOKIE_SECURE=true
WEB_ORIGINS=https://rag.baolinfeng.cn
USER_COOKIE_SECURE=true

# 注册与找回密码的验证码邮件；不配置时生产环境相关接口返回 503。
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# 其余可选项（限流、文章同步、向量化重试等）见仓库根目录 .env.example，不写则用默认值。
NYZ_MODEL_CREDENTIAL_ENVS=
