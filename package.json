{
  "name": "nyz-rag",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "pnpm --filter @nyz-rag/processing build && pnpm --parallel --filter @nyz-rag/api --filter @nyz-rag/web --filter @nyz-rag/worker dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @nyz-rag/processing build && pnpm -r typecheck",
    "db:migrate": "pnpm --filter @nyz-rag/processing db:migrate",
    "db:import-snapshot": "pnpm --filter @nyz-rag/processing db:import-snapshot",
    "db:reindex-search": "pnpm --filter @nyz-rag/processing db:reindex-search",
    "db:generate": "pnpm --filter @nyz-rag/processing db:generate"
  }
}
